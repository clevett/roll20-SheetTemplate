//- Semantic Versioning MAJOR.MINORPATCH
input(name='attr_version' type='hidden' value='3.3')

//- Do not manually change this. Hidden attribute used by versioning script
input(name='attr_latest_versioning_upgrade' type='hidden' value='1')

//- include pug/components/repeating_section.pug
//- include pug/components/roll_templates.pug
//- include pug/constants.pug
//- include pug/mixins.pug
include constants/index
include components/index


- const dashedName = name => name.replace(/ /g, '-');
- const attrName = name => name.replace(/ /g, '_').toLowerCase();
- const removeSpace = name => name.replace(/ /g, '');
- const toLowerCase = name => name.toLowerCase();


.dropzone.compendium-drop-target.creatures.pregens
    //- Hidden inputs to accept drop data from compendium
    each val in ['Name', 'data', 'Content', "Category"]
        input(name=`attr_drop_${val.toLowerCase()}` type='hidden' value='' accept=val)

    //- Hidden input to identify sheet type. Used CSS to change the view based value
    input(name='attr_sheet_type' type='hidden' value='character')
    input(name='attr_edit_mode' type='hidden' value='off')
    input(name='attr_settings' type='hidden' value='on')

    .relative
        .mode-toggles.absolute.grid.gap-2.grid-flow-col.items-center.justify-self-end.z-index-10
            +Button({name: "edit mode", type: BUTTON_TYPES.ACTION, variant: BUTTON_VARIANT.ICON })
                +Icon({ icon: "editAlt" })
            +Button({name: "settings", type: BUTTON_TYPES.ACTION, variant: BUTTON_VARIANT.ICON })
                +Icon({ icon: "settings" })

    include views/settings.pug

    .view.w-full.h-full
      include views/style_guide.pug
      include views/character.pug
      include views/npc.pug




.compendium_warning
  span(data-i18n="accepting drop") ACCEPTING DROP FROM COMPENDIUM

.footer
  span Version  
  span(name='attr_version')
  span Original template created by Emerald Productions, LLC
  img(src="https://raw.githubusercontent.com/clevett/roll20-SheetTemplate/master/src/imgs/EProd_Emerald_Gloss.png", alt="Emerald Productions logo of an E")


//- SCRIPTS
script(type="text/worker")
  include scripts.js

