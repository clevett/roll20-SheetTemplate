.character.grid.gap-4
    input(type="hidden" name="attr_character_tab" value="main")
    .grid.gap-4.grid-flow-col.p-4.items-center.items-start
        .bg-neutral-200.grid.min-w-3xs.max-w-3xs.items-center
            span.text-center Logo goes here
        .grid.grid-cols-2.gap-2.items-center
            .col-auto-fr.grid.gap-2.grid-flow-col.items-center
                +Header({ name: "name", size: "h4" })
                +Input({ name: "character name" })
            each val in ["class", "background" , "age", "size", "appearance"]
                .col-auto-fr.grid.gap-2.grid-flow-col.items-center
                    +Header({ name: val, size: "h4" })
                    +Input({ name: val })
                                            
    .grid.tablist.rounded-t-md
        +Tabs({values: Object.values(TABS), attr: 'character_tab'})

    .main 
        span.text-center Main character sheet content goes here

    .combat
        span.text-center Combat character sheet content goes here

    .magic
        span.text-center Magic character sheet content goes here
