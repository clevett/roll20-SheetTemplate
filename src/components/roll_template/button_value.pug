    const buttonValue = (props) => {
        const templatePrefix = "&{template:roll}"
        //- - const criticalStrike = "cs@{critical_hit}cf@{critical_fail}"
        // const attribute = "@{attribute}[attribute]"
        // const bonus = "(@{modifier}[modifier])"
        //- - const prompt = "(?{Modifier|0}[modifier])"

        const {name, type } = props || {};
        
        let string = `${templatePrefix} `

        switch(type) {
            case BUTTON_VALUE.REPEATING_CHAT:
            case BUTTON_VALUE.REPEATING_DAMAGE:
                string += `{{header=@{name}}} `;
                break;
            default:
                string += `{{header=^{${name}}}} `;
        }

        switch(type) {
            case BUTTON_VALUE.ATTACK:
                string += ` {{dice=[[1d20]+(@{modifier}[modifier])]}} {{damage=[Damage](~repeating_actions-roll_damage)}}`;
                break;
            case BUTTON_VALUE.D20:
                string += ` {{dice=[[1d20]]}} `;
                break;
            case BUTTON_VALUE.REPEATING_DAMAGE:
                string += `{{dice=[[@{damage}[damage]+(@{modifier}[damage modifier])]]}} {{damage=@{damage_type} ^{damage}}} `;
                break;
            case BUTTON_VALUE.DESCRIPTION: 
                string += ` {{description=@{example_textarea}}} `;
                break;
            default:
                string += "";
        }

        return string || "{{description=Roll Template is not working as expected}}";
    }

