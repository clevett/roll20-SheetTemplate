mixin RepeatingSectionHeader({ sectionName, display })
	- const [name, ...rest] = display
	.grid.gap-2.content-start.relative
		+Header({ name: sectionName, size: "h2" }).block.text-center
		.grid.gap-4.grid-flow-col.items-center.border-b.auto-cols-fr
			+Header({ name, size: "h3" }).w-full
			each val in [...rest]
				+Header({ name: val, size: "h3" }).text-center.w-full

mixin RepeatingSection({ sectionName })
	//- fieldset class format = repeating_example-repeating-section
	//- Add section name to repeating_section.ts to enable toggle buttons
	fieldset(class=`repeating_${dashedName(sectionName)}`)
		.grid.gap-2.items-center
			input(type="hidden" name="attr_state" value="edit expand")
			block

mixin RepeatingSectionRow()
	.grid.gap-4.grid-flow-col.items-center.auto-cols-fr.relative
		+Button({ name: "name", type: BUTTON_TYPES.ROLL, value: BUTTON_VALUE.REPEATING_CHAT }).text-left
			+Text({ name: "name" })
		block
		.toggles.absolute.auto-cols-min.grid.gap-2.grid-flow-col.items-center.justify-self-end.z-index-10
			+Button({ name: "edit", type: BUTTON_TYPES.ACTION, variant: BUTTON_VARIANT.ICON }).edit
				+Icon({ icon: "editAlt", color: "color-neutral-50",  })
			+Button({ name: "expand", type: BUTTON_TYPES.ACTION, variant: BUTTON_VARIANT.ICON }).expand
				+Icon({ icon: "play", color: "color-neutral-50", })


mixin RepeatingSectionExpand()
	.expand.grid.gap-2.items-center.pl-2
		.grid.gap-2.items-center.content-start.w-full
			block
		.flex.ellipse.w-full
			+Text({name: "description"})
	
mixin RepeatingSectionEdit()
	.edit.bg-neutral-200.border-neutral-200.border-solid.border-2.grid.gap-2.items-center.rounded-xl.p-2
		.auto-cols-fr.grid.gap-2.grid-flow-col.items-center
			block
					
		.grid.gap-2.items-center.w-full
			+Header({ name: "description", size: "h4" })
			+Textarea({ name: "description", placeholder: "Enter description here..." })

